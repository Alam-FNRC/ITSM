<?xml version="1.0" encoding="utf-8"?>
<!-- IIS settings for the published site. The publish fills in the program to start. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <!-- As a sub-application (staging.fnrc.gov.ae/itsm) the site inherits the parent's handlers; a parent that
             also runs ASP.NET Core would otherwise register this handler twice (error 500.19) -->
        <remove name="aspNetCore" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\ItsTool.API.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
