<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>62180508-a484-4733-91d9-9f8865af1709</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.29" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.33">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ItsTool.Application\ItsTool.Application.csproj" />
    <ProjectReference Include="..\ItsTool.Infrastructure\ItsTool.Infrastructure.csproj" />
  </ItemGroup>

  <!-- A publish is the whole site: the pages from ItsTool.Web go to wwwroot, where Program.cs looks for them.
       Local settings and files saved while developing stay out. -->
  <ItemGroup>
    <Content Include="..\ItsTool.Web\wwwroot\**" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Remove="uploads\**;evidence\**" />
    <None Remove="uploads\**;evidence\**" />
  </ItemGroup>


  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ItsTool.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
